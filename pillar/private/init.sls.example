# Copy this file to pillar/private/init.sls on the Salt master with values filled in.
# It is gitignored (pillar/private/*.sls) and must never be committed.

monitoring:
  icinga_api_host: monitoring-us-east-021.ovvin.wonet
  icinga_api_password: CHANGE_ME
  ido_db_password: CHANGE_ME
  director_db_password: CHANGE_ME
  monitoring_db_password: CHANGE_ME
  grafana_admin_password: CHANGE_ME
  mysqld_exporter_password: CHANGE_ME
  # Cloudflare API token (Account Analytics:Read + Zone Analytics:Read),
  # used by the cloudflare_exporter service on the monitoring host.
  cloudflare_exporter_token: CHANGE_ME

notifications:
  discord_webhook_url: https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
  slack_webhook_url: https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
  incidentio_url: https://api.incident.io/v2/alert_events/http/CHANGE_ME
  incidentio_token: CHANGE_ME

mediawiki:
  webhooks:
    discord: ""
    slack: ""
  # Private half of pillar/mediawiki/init.sls's deploy_ssh_public_key. staging
  # only; this is what lets the (legacy, still in use) mwdeploy CLI SSH from
  # staging out to every mw*/proxy* box as the mwdeploy user.
  deploy_ssh_private_key: |
    -----BEGIN OPENSSH PRIVATE KEY-----
    CHANGE_ME
    -----END OPENSSH PRIVATE KEY-----

sentry_relay:
  dsn: CHANGE_ME

sentry_logging:
  journald_dsn: CHANGE_ME
  nginx_dsn: CHANGE_ME

mwdeploy_portal:
  # `openssl rand -hex 24` (any opaque string) — used for both DB user and DB
  # backup is irrelevant here, this is the small app schema, not the wiki DB.
  db_password: CHANGE_ME
  # `openssl rand -base64 32`, prefixed "base64:" — same format
  # `php artisan key:generate --show` would produce. Rotating it invalidates
  # every session and every encrypted 2FA secret.
  app_key: CHANGE_ME
  # `openssl rand -hex 24` each. Shared secrets between the app, the Reverb
  # server and the browser: the key is public (ends up in the JS bundle), the
  # secret is app<->Reverb only.
  reverb_app_key: CHANGE_ME
  reverb_app_secret: CHANGE_ME

mariadb:
  backup:
    # 'server' (default): stream directly to the dedicated backup server below,
    #   over SSH — the normal, long-term destination.
    # 'drive': TEMPORARY STOPGAP — push into Google Drive via rclone instead
    #   (see rclone_drive below). Both destination configs can stay populated
    #   at once; this just switches which one mariadb-backup-run.sh uses.
    mode: server
    # MariaDB user Salt will create on each db* server for backup operations
    user: mariadb_backup
    password: CHANGE_ME
    # Used when mode: server
    destination:
      # IP or hostname of the external backup server
      host: CHANGE_ME
      user: mariadb-backup
      # Absolute path on the backup server; subdirs per host are created automatically
      path: /mnt/backups/mariadb
    # Cron schedule (UTC). Defaults shown; override per host (e.g. in
    # pillar/mariadb/<host>.sls) to stagger backups across servers.
    schedule:
      full_hour: '1'          # weekly full backup, Sunday
      full_minute: '0'
      incremental_hour: '2'   # daily incremental, Mon-Sat
      incremental_minute: '0'
    # Private key whose public half is in authorized_keys on the backup
    # server. Only used when mode: server.
    ssh_private_key: |
      -----BEGIN OPENSSH PRIVATE KEY-----
      CHANGE_ME
      -----END OPENSSH PRIVATE KEY-----
    # Used when mode: drive. Recommended way to obtain these values (works
    # headlessly, no interactive OAuth needed for a cron job):
    #   1. In a Google Cloud project, enable the "Google Drive API" and
    #      create a Service Account (IAM & Admin > Service Accounts).
    #   2. Create a JSON key for it (Keys > Add Key > Create new key > JSON)
    #      and paste its full contents into service_account_json below.
    #   3. Service accounts have NO personal Drive storage of their own, so
    #      uploads will fail with a quota error unless you share somewhere
    #      with it first: either share a normal Drive folder with the
    #      service account's client_email (found in the JSON) as Editor and
    #      set folder_id to that folder's ID, OR (better, no quota
    #      surprises) add the service account as a member of a Shared Drive
    #      and set team_drive_id instead.
    rclone_drive:
      # Full contents of the service account's JSON key file
      service_account_json: |
        {
          "type": "service_account",
          "...": "CHANGE_ME"
        }
      # ID of a Drive folder shared with the service account (from the
      # folder's URL: drive.google.com/drive/folders/<THIS_PART>). Use this
      # OR team_drive_id below, not both.
      folder_id: CHANGE_ME
      # ID of a Shared Drive (Team Drive) the service account is a member
      # of. Preferred over folder_id when a Shared Drive is available.
      # team_drive_id: CHANGE_ME
      # Path inside the shared folder/Shared Drive to store backups under
      path: backups/mariadb
