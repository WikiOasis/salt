# Copy this file to pillar/private/init.sls on the Salt master with values filled in.
# It is gitignored (pillar/private/*.sls) and must never be committed.

monitoring:
  icinga_api_host: monitoring-us-east-021.ovvin.wonet
  icinga_api_password: CHANGE_ME
  ido_db_password: CHANGE_ME
  director_db_password: CHANGE_ME
  monitoring_db_password: CHANGE_ME
  grafana_admin_password: CHANGE_ME
  mysqld_exporter_password: CHANGE_ME
  # Cloudflare API token (Account Analytics:Read + Zone Analytics:Read),
  # used by the cloudflare_exporter service on the monitoring host.
  cloudflare_exporter_token: CHANGE_ME

notifications:
  discord_webhook_url: https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
  slack_webhook_url: https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
  incidentio_url: https://api.incident.io/v2/alert_events/http/CHANGE_ME
  incidentio_token: CHANGE_ME

mediawiki:
  webhooks:
    discord: ""
    slack: ""
  # Private half of pillar/mediawiki/init.sls's deploy_ssh_public_key. staging
  # only; this is what lets the (legacy, still in use) mwdeploy CLI SSH from
  # staging out to every mw*/proxy* box as the mwdeploy user.
  deploy_ssh_private_key: |
    -----BEGIN OPENSSH PRIVATE KEY-----
    CHANGE_ME
    -----END OPENSSH PRIVATE KEY-----

incidentio_sync:
  # Discord webhook the status-page-to-Discord sync posts/edits messages
  # through. Anyone holding this URL can post to the channel, hence private
  # pillar rather than pillar/incidentio_sync. Not the same webhook as
  # notifications:discord_webhook_url above — that one is generic alerting,
  # this one is dedicated to the incident.io status page mirror.
  discord_webhook_url: https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

sentry_relay:
  dsn: CHANGE_ME

sentry_logging:
  journald_dsn: CHANGE_ME
  nginx_dsn: CHANGE_ME

mwdeploy_portal:
  # `openssl rand -hex 24` (any opaque string) — used for both DB user and DB
  # backup is irrelevant here, this is the small app schema, not the wiki DB.
  db_password: CHANGE_ME
  # `openssl rand -base64 32`, prefixed "base64:" — same format
  # `php artisan key:generate --show` would produce. Rotating it invalidates
  # every session and every encrypted 2FA secret.
  app_key: CHANGE_ME
  # `openssl rand -hex 24` each. Shared secrets between the app, the Reverb
  # server and the browser: the key is public (ends up in the JS bundle), the
  # secret is app<->Reverb only.
  reverb_app_key: CHANGE_ME
  reverb_app_secret: CHANGE_ME

# TSPortal, the Trust & Safety queue (salt/tsportal, pillar/tsportal). Every
# value below is read by salt/tsportal/files/tsportal.env.jinja; the app boots
# with none of them set but 500s on the first request, because an empty APP_KEY
# fails the Encrypter's cipher/key-length check. salt/tsportal/init.sls guards
# the five that are load-bearing.
tsportal:
  # `openssl rand -base64 32`, prefixed "base64:" — the format
  # `php artisan key:generate --show` produces. Rotating it invalidates every
  # session and everything the app has encrypted at rest.
  app_key: CHANGE_ME
  # Must match what mariadb.tsportal_db created on db-other-us-east-011 for
  # the tsportal_new user in pillar/tsportal db:user.
  db_password: CHANGE_ME
  # Shared secret between the wiki and the portal. Anyone holding it can file
  # reports and read any account's standing, so treat it like a password.
  s2s_secret: CHANGE_ME
  # OAuth consumer registered on meta.wikioasis.org for the redirect_uri in
  # pillar/tsportal. The id is not secret; it lives here to stay next to its
  # secret.
  oauth_client_id: CHANGE_ME
  oauth_client_secret: CHANGE_ME
  # Cloudflare R2 token scoped to the wikioasis-media bucket. Only needed when
  # pillar/tsportal attachments:enabled is true; without it uploads fail but
  # the rest of the portal works.
  r2_access_key_id: CHANGE_ME
  r2_secret_access_key: CHANGE_ME
  # SMTP account for the mail: block in pillar/tsportal (Gmail, submissions
  # over smtps/465 — an app password, not the account password).
  mail_username: CHANGE_ME
  mail_password: CHANGE_ME
  # Per-category Slack webhooks. `default` is the fallback for any category
  # without its own; the others may be omitted entirely.
  slack_webhooks:
    default: https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
    urgent: ""
    cases: ""
    actions: ""
    admin: ""
    data: ""

mariadb:
  backup:
    # MariaDB user Salt will create on each db* server for backup operations
    user: mariadb_backup
    password: CHANGE_ME
    # zstd the xbstream before upload. Backups are stored compressed, so restore
    # is `aws s3 cp <obj> - | zstd -dc | mbstream -x -C <dir>`. Set false to
    # store raw xbstream instead.
    compress: true
    # OVHcloud Object Storage (S3). Backup sets and binlogs both live here; a
    # bucket can be shared by every db* host (keys are prefixed per hostname).
    # DO NOT enable versioning on this bucket — the active binlog is overwritten
    # every 5 minutes and each overwrite would be retained as a noncurrent version.
    s3:
      bucket: CHANGE_ME
      # OVH region code. The endpoint is derived from it as
      #   https://s3.<region>.io.cloud.ovh.us   for US regions (us-east-va, us-west-or)
      #   https://s3.<region>.io.cloud.ovh.net  for everything else
      # because OVHcloud US is a separate entity on its own domain. Regions on
      # .net include gra, rbx, sbg, eu-west-par, eu-south-mil, de, uk, waw, bhs,
      # ca-east-tor, sgp, ap-southeast-syd, ap-south-mum. Lifecycle rules only
      # work on the `.io` endpoint, never the legacy `.perf` one. Set `endpoint:`
      # to override the derivation outright.
      region: gra
      # S3 user credentials from the OVHcloud control panel (Object Storage >
      # S3 users). Needs read/write on the bucket plus PutBucketLifecycle.
      access_key: CHANGE_ME
      secret_key: CHANGE_ME
      # Optional key prefix inside the bucket, e.g. 'mariadb'. Keys become
      # <prefix>/<hostname>/sets/... and <prefix>/<hostname>/binlogs/...
      prefix: ''
      # Storage class written on the PUT, so write-once objects (backup sets and
      # rotated binlogs) are billed as Infrequent Access immediately instead of
      # spending a day at Standard rates. OVHcloud maps its Infrequent Access
      # tier onto the standard S3 name. Objects that get overwritten — the
      # still-growing binlog, the `sets/latest` pointer — deliberately stay in
      # Standard: an overwrite counts as a delete against IA's 30-day minimum.
      # Note IA also charges a per-GiB retrieval fee, so restores are not free.
      storage_class: STANDARD_IA
      # A full is one streamed multipart object and S3 caps an object at 10000
      # parts, so this sets the size ceiling: 128MB x 10000 = 1.28TB. The CLI
      # buffers chunksize x max_concurrent_requests in RAM while uploading.
      multipart_chunksize: 128MB
      max_concurrent_requests: 4
      # Bucket lifecycle policy — this is the ONLY thing that deletes old
      # backups; the scripts never remove remote data. It expires objects and
      # nothing else: objects are already in storage_class when they land, and
      # a transition rule would fire on object AGE across the whole prefix,
      # which would drag the deliberately-Standard active binlog into IA on an
      # idle server. S3 prefix filters are literal, so there is no way to write
      # one that covers sets but not binlogs.
      lifecycle:
        # Days after upload before an object is deleted. IA is billed for a
        # 730h (30 day) minimum per object — deleting sooner is charged for the
        # remainder anyway — so this is clamped up to min_storage_days if set
        # lower. 35 keeps ~5 weekly sets.
        expire_days: 35
        min_storage_days: 30
        # Sweep up parts left behind by a full backup upload that died mid-flight.
        # They are billed but never show up in a listing.
        abort_incomplete_multipart_days: 7
    # Cron schedule (UTC). Defaults shown; override per host (e.g. in
    # pillar/mariadb/<host>.sls) to stagger backups across servers.
    schedule:
      full_hour: '1'          # weekly full backup, Sunday
      full_minute: '0'
      incremental_hour: '2'   # daily incremental, Mon-Sat
      incremental_minute: '0'
    # Sentry Crons check-ins, so a missed or failed backup alerts like any other
    # monitor. DSN is the normal per-project DSN (Settings > Projects > <project>
    # > Client Keys) — parsed for the ingest host, project id and public key that
    # the check-in URL needs. Leave dsn blank to disable check-ins entirely.
    sentry:
      dsn: ''
      # Separate monitors per cron job so a missed weekly full and a missed
      # daily incremental page differently. checkin_margin/max_runtime are
      # minutes; full backups run far longer than incrementals so they get a
      # longer runtime budget before Sentry flags them as stuck.
      full:
        monitor_slug: mariadb-backup-full
        checkin_margin: 30
        max_runtime: 360
      incremental:
        monitor_slug: mariadb-backup-incremental
        checkin_margin: 15
        max_runtime: 120
