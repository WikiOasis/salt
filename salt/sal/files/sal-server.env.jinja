{%- set sal = salt['pillar.get']('sal', {}) %}
{%- set server = sal.get('server', {}) %}
{%- set db = sal.get('db', {}) %}
{%- set wiki = sal.get('wiki', {}) %}
{%- set phorge = sal.get('phorge', {}) %}
SAL_LISTEN_HOST={{ server.get('listen_host', '127.0.0.1') }}
SAL_LISTEN_PORT={{ server.get('listen_port', 8740) }}
SAL_POLL_INTERVAL={{ server.get('poll_interval', 5) }}
SAL_MAX_ATTEMPTS={{ server.get('max_attempts', 50) }}
SAL_MAX_MESSAGE={{ server.get('max_message', 2000) }}
SAL_LOG_LEVEL={{ server.get('log_level', 'INFO') }}
SAL_SECRET={{ sal.get('secret', '') | tojson }}
SAL_DB_HOST={{ db.get('host', 'db-other-us-east-011.ovvin.wonet') }}
SAL_DB_PORT={{ db.get('port', 3306) }}
SAL_DB_NAME={{ db.get('name', 'sal') }}
SAL_DB_USER={{ db.get('user', 'sal') }}
SAL_DB_PASSWORD={{ sal.get('db_password', '') | tojson }}
SAL_WIKI_ENABLED={{ 1 if wiki.get('enabled', True) else 0 }}
SAL_WIKI_API={{ wiki.get('api', 'https://meta.wikioasis.org/w/api.php') }}
SAL_WIKI_PAGE={{ wiki.get('page', 'Tech:Server admin log') | tojson }}
SAL_WIKI_PAGE_URL={{ wiki.get('page_url', 'https://meta.wikioasis.org/wiki/Tech:Server_admin_log') }}
SAL_WIKI_USER={{ wiki.get('user', '') | tojson }}
SAL_WIKI_PASSWORD={{ wiki.get('password', '') | tojson }}
SAL_PHORGE_ENABLED={{ 1 if phorge.get('enabled', True) else 0 }}
SAL_PHORGE_BASE={{ phorge.get('base', 'https://phorge.wikioasis.org') }}
SAL_PHORGE_HOOK={{ phorge.get('hook', 'https://phorge.wikioasis.org/sal/hook') }}
SAL_PHORGE_TOKEN={{ phorge.get('token', '') | tojson }}
