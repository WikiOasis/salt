{#- TSPortal .env — managed by Salt, do not edit manually.
   Secrets come from pillar/private (gitignored); everything else from
   pillar/tsportal. Rendered on the minion when the state runs, i.e. after
   the git checkout, which is why APP_VERSION can read the working tree. #}
{%- set p = salt['pillar.get']('tsportal', {}) %}
{%- set path = p.get('path', '/srv/tsportal') %}
{%- set db = p.get('db', {}) %}
{%- set mw = p.get('mediawiki', {}) %}
{%- set oauth = mw.get('oauth', {}) %}
{%- set pii = mw.get('pii', {}) %}
{%- set att = p.get('attachments', {}) %}
{%- set r2 = att.get('r2', {}) %}
{%- set threat = p.get('threat_to_life', {}) %}
{%- set slack = p.get('slack', {}) %}
{%- set mail = p.get('mail', {}) %}
{%- set domain = p.get('domain', 'safety.wikioasis.org') %}
{%- set commit = salt['cmd.run']('git -C ' ~ path ~ ' rev-parse --short HEAD 2>/dev/null', python_shell=True, ignore_retcode=True) %}

APP_NAME="WikiOasis Trust & Safety"
APP_ENV=production
APP_KEY={{ salt['pillar.get']('tsportal:app_key', '') }}
APP_DEBUG=false
APP_URL=https://{{ domain }}

# Shown on the login screen, so "it's broken" can be matched to a build.
APP_VERSION={{ commit or p.get('rev', 'main') }}

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL={{ p.get('log_level', 'info') }}

DB_CONNECTION=mysql
DB_HOST={{ db.get('host', '127.0.0.1') }}
DB_PORT=3306
DB_DATABASE={{ db.get('name', 'tsportal') }}
DB_USERNAME={{ db.get('user', 'tsportal') }}
DB_PASSWORD={{ salt['pillar.get']('tsportal:db_password', '') }}

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=local

# Outbound mail. `log` writes to storage/logs and sends nothing — see
# pillar/tsportal's mail:mailer for why that is the default and what to do
# about it. Everything here is queued, so the worker is what actually sends.
#
# The username and password are quoted because a relay-issued password is
# arbitrary punctuation, and an unquoted `#` would be read as the start of a
# comment. A literal `"` or backslash in one still needs escaping in the pillar.
MAIL_MAILER={{ mail.get('mailer', 'log') }}
MAIL_SCHEME={{ mail.get('scheme', 'smtp') }}
MAIL_HOST={{ mail.get('host', '127.0.0.1') }}
MAIL_PORT={{ mail.get('port', 587) }}
MAIL_USERNAME="{{ salt['pillar.get']('tsportal:mail_username', '') }}"
MAIL_PASSWORD="{{ salt['pillar.get']('tsportal:mail_password', '') }}"
MAIL_EHLO_DOMAIN={{ mail.get('ehlo_domain', domain) }}
MAIL_FROM_ADDRESS="{{ mail.get('from_address', 'safety@wikioasis.org') }}"
MAIL_FROM_NAME="{{ mail.get('from_name', 'WikiOasis Trust & Safety') }}"

VITE_APP_NAME="${APP_NAME}"

###############################################################################
# The wiki farm
###############################################################################

MW_CENTRAL_URL={{ mw.get('central_url', 'https://meta.wikioasis.org') }}
MW_API_URL={{ mw.get('api_url', 'https://meta.wikioasis.org/w/api.php') }}
MW_REST_URL={{ mw.get('rest_url', 'https://meta.wikioasis.org/w/rest.php') }}
MW_USER_AGENT="{{ mw.get('user_agent', 'TSPortal/1.0 (https://' ~ domain ~ '; trustandsafety@wikioasis.org)') }}"

MW_OAUTH_CLIENT_ID={{ salt['pillar.get']('tsportal:oauth_client_id', '') }}
MW_OAUTH_CLIENT_SECRET={{ salt['pillar.get']('tsportal:oauth_client_secret', '') }}
MW_OAUTH_REDIRECT_URI={{ oauth.get('redirect_uri', 'https://' ~ domain ~ '/auth/mediawiki/callback') }}
MW_OAUTH_SCOPES={{ oauth.get('scopes', 'basic') }}

# A standing back door for as long as it is non-empty — see pillar/tsportal.
MW_BOOTSTRAP_ADMINS={{ mw.get('bootstrap_admins', '') }}

# Shared with $wgWikiOasisSafetyPortalSecret in the farm's LocalSettings.php.
# Anyone holding it can file reports and read any account's standing.
MW_S2S_SECRET={{ salt['pillar.get']('tsportal:s2s_secret', '') }}
MW_S2S_PUSH_ENABLED={{ mw.get('push_enabled', true) | lower }}

MW_SUPPORTED_ACTIONS={{ mw.get('supported_actions', 'lock,unlock,warn,note,block,unblock,delete-wiki,undelete-wiki,rename,renamestatus,removepii') }}
MW_CENTRALAUTH_LOCK={{ mw.get('centralauth_lock', true) | lower }}

MW_PII_ENABLED={{ pii.get('enabled', false) | lower }}
MW_PII_USERNAME_PREFIX={{ pii.get('username_prefix', 'WikiOasisGDPR_') }}
MW_PII_RENAME_TIMEOUT_HOURS={{ pii.get('rename_timeout_hours', 24) }}

###############################################################################
# Evidence
###############################################################################

TS_ATTACHMENTS_ENABLED={{ att.get('enabled', true) | lower }}
TS_ATTACHMENTS_DISK={{ att.get('disk', 'local') }}
TS_ATTACHMENTS_PREFIX={{ att.get('prefix', 'case-attachments') }}
TS_ATTACHMENTS_MAX_BYTES={{ att.get('max_bytes', 26214400) }}
TS_ATTACHMENTS_MAX_PER_CASE={{ att.get('max_per_case', 20) }}
{%- if att.get('allowed_mime') %}
TS_ATTACHMENTS_ALLOWED_MIME={{ att.get('allowed_mime') }}
{%- endif %}

# Cloudflare R2 through the S3 driver, against wikioasis-media/tsportal/.
#
# AWS_ENDPOINT is where this app writes (the S3 API, authenticated with the
# keys below); AWS_URL is where a reader would fetch from (cdn.wikioasis.org,
# public). Nothing in TSPortal calls ->url() on this disk today — reads stream
# through AttachmentController::show, which checks access and writes an
# `attachment.read` audit row — so AWS_URL is what a later change that wants a
# CDN link would use. See pillar/tsportal for why listing must stay off.
AWS_ACCESS_KEY_ID={{ salt['pillar.get']('tsportal:r2_access_key_id', '') }}
AWS_SECRET_ACCESS_KEY={{ salt['pillar.get']('tsportal:r2_secret_access_key', '') }}
AWS_DEFAULT_REGION={{ r2.get('region', 'auto') }}
AWS_BUCKET={{ r2.get('bucket', '') }}
AWS_ENDPOINT={{ r2.get('endpoint', '') }}
AWS_URL={{ r2.get('public_url', '') }}
AWS_USE_PATH_STYLE_ENDPOINT={{ r2.get('path_style', true) | lower }}

###############################################################################
# The reports that cannot wait
###############################################################################

TS_THREAT_TO_LIFE_CATEGORIES={{ threat.get('categories', '') }}
TS_THREAT_TO_LIFE_PRIORITY={{ threat.get('priority', 'urgent') }}

###############################################################################
# Slack
###############################################################################

SLACK_ACTIVITY_ENABLED={{ slack.get('enabled', false) | lower }}
SLACK_WEBHOOK_URL={{ salt['pillar.get']('tsportal:slack_webhooks:default', '') }}
SLACK_WEBHOOK_URGENT={{ salt['pillar.get']('tsportal:slack_webhooks:urgent', '') }}
SLACK_WEBHOOK_CASES={{ salt['pillar.get']('tsportal:slack_webhooks:cases', '') }}
SLACK_WEBHOOK_ACTIONS={{ salt['pillar.get']('tsportal:slack_webhooks:actions', '') }}
SLACK_WEBHOOK_DATA={{ salt['pillar.get']('tsportal:slack_webhooks:data', '') }}
SLACK_WEBHOOK_ADMIN={{ salt['pillar.get']('tsportal:slack_webhooks:admin', '') }}
SLACK_THREAT_MENTION={{ slack.get('mention', '') }}
SLACK_ACTIVITY_IGNORE={{ slack.get('ignore', '') }}
SLACK_ACTIVITY_INCLUDE_SUBJECTS={{ slack.get('include_subjects', false) | lower }}
SLACK_PORTAL_URL=https://{{ domain }}
SLACK_ACTIVITY_QUEUE=true
SLACK_TIMEOUT=5
