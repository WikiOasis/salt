# Shared S3 settings for the authentik backup scripts. Sourced with `set -a` by
# authentik-backup and authentik-backup-s3-init, so every AWS_* name here also
# becomes an environment variable for the aws CLI.
#
# Deliberately a copy of mariadb's equivalent rather than a shared file: the two
# read different pillar trees and may point at different buckets, and coupling
# them would mean a change for one silently retargeting the other's uploads.
{%- set backup = salt['pillar.get']('authentik:backup', {}) %}
{%- set s3 = backup.get('s3', {}) %}
{%- set region = s3.get('region', 'gra') %}
{#- OVHcloud US is a separate entity from OVHcloud EU/CA and its object storage
    sits on a different domain: the US regions (us-east-va, us-west-or) answer
    on .io.cloud.ovh.us, every other region on .io.cloud.ovh.net. Getting this
    wrong is an NXDOMAIN, not an auth error, so it surfaces as "bucket not
    reachable". Set `endpoint:` in pillar to override the derivation outright.

    Note `.io` and not the legacy `.perf` endpoint — the latter silently
    rejects lifecycle rules. #}
{%- set domain = 'io.cloud.ovh.us' if region.startswith('us-') else 'io.cloud.ovh.net' %}
{%- set endpoint = s3.get('endpoint', 'https://s3.' ~ region ~ '.' ~ domain) %}
{%- set prefix = s3.get('prefix', 'authentik').strip('/') %}
S3_BUCKET='{{ s3.get('bucket', '') }}'
S3_REGION='{{ region }}'
S3_ENDPOINT='{{ endpoint }}'
S3_PREFIX='{{ prefix }}'
# Storage class, set on the PUT itself so the dump is billed as Infrequent
# Access from the moment it lands rather than spending a day in Standard first.
# Safe here in a way it is not for mariadb's binlogs: every key carries a
# timestamp, so a dump is written exactly once and never overwritten — an
# overwrite would count as a delete against IA's 30-day minimum.
S3_STORAGE_CLASS='{{ s3.get('storage_class', 'STANDARD_IA') }}'
# Whether authentik-backup-s3-init may write a bucket lifecycle policy. See the
# warning in authentik-backup-lifecycle.json.jinja before turning this on.
S3_MANAGE_LIFECYCLE='{{ 'true' if s3.get('manage_lifecycle', False) else 'false' }}'

AWS_CONFIG_FILE=/etc/authentik-backup/aws.conf
AWS_SHARED_CREDENTIALS_FILE=/etc/authentik-backup/credentials
# These are not EC2 instances; without this the CLI stalls probing IMDS
# whenever a credential lookup misses.
AWS_EC2_METADATA_DISABLED=true
