{%- set p = salt['pillar.get']('authentik', {}) %}
{%- set db = p.get('db', {}) %}
{%- set email = p.get('email', {}) %}
{%- set bootstrap_email = salt['pillar.get']('authentik:bootstrap_email', '') %}
{%- set bootstrap_password = salt['pillar.get']('authentik:bootstrap_password', '') %}
{%- set bootstrap_token = salt['pillar.get']('authentik:bootstrap_token', '') %}
# Managed by Salt (salt/authentik) -- do not edit by hand.
#
# Holds the database password and the key that signs sessions and encrypts
# stored credentials, hence 0600 and show_changes: False on the state that
# writes it. Read by docker compose for ${...} interpolation in
# docker-compose.yml and handed to all three containers as their env_file.

PG_DB={{ db.get('name', 'authentik') }}
PG_USER={{ db.get('user', 'authentik') }}
PG_PASS={{ salt['pillar.get']('authentik:postgres_password', '') }}

# Rotating this invalidates every session and makes everything authentik has
# encrypted at rest -- provider client secrets, MFA seeds, source credentials --
# unreadable. It is not a password; it is the key.
AUTHENTIK_SECRET_KEY={{ salt['pillar.get']('authentik:secret_key', '') }}

AUTHENTIK_LOG_LEVEL={{ p.get('log_level', 'info') }}
# Off: crashes go to our own Sentry through the host log pipeline, not to
# authentik's hosted project.
AUTHENTIK_ERROR_REPORTING__ENABLED={{ 'true' if p.get('error_reporting', False) else 'false' }}
AUTHENTIK_DISABLE_STARTUP_ANALYTICS={{ 'true' if p.get('disable_analytics', True) else 'false' }}
# Left on: this is how a new release shows up in the admin interface, and an IdP
# is not a thing to leave quietly out of date.
AUTHENTIK_DISABLE_UPDATE_CHECK={{ 'true' if p.get('disable_update_check', False) else 'false' }}

# X-Forwarded-For from proxy-us-east-021 (10.0.2.2) and from the Docker bridge
# are both inside authentik's default trusted-proxy CIDRs, so client IPs in the
# event log are the real ones without extra configuration. Set
# authentik:trusted_proxy_cidrs in pillar if that ever stops being true.
{%- if p.get('trusted_proxy_cidrs') %}
AUTHENTIK_LISTEN__TRUSTED_PROXY_CIDRS={{ p.trusted_proxy_cidrs | join(',') }}
{%- endif %}
{%- if p.get('cookie_domain') %}

# Widens the session cookie to the whole domain, which is what lets a proxy
# provider on some other *.wikioasis.org host see the session. Unset means a
# host-only cookie for {{ p.get('domain', 'id.wikioasis.org') }}, which is the
# safer default and enough for OIDC and SAML.
AUTHENTIK_COOKIE_DOMAIN={{ p.cookie_domain }}
{%- endif %}
{%- if email.get('host') %}

# Password recovery, invitations and event notifications. authentik runs
# perfectly well without these, it just cannot send mail -- which means a
# locked-out account needs an admin instead of a reset link.
AUTHENTIK_EMAIL__HOST={{ email.host }}
AUTHENTIK_EMAIL__PORT={{ email.get('port', 587) }}
AUTHENTIK_EMAIL__USERNAME={{ email.get('username', '') }}
AUTHENTIK_EMAIL__PASSWORD={{ salt['pillar.get']('authentik:email_password', '') }}
AUTHENTIK_EMAIL__USE_TLS={{ 'true' if email.get('use_tls', True) else 'false' }}
AUTHENTIK_EMAIL__USE_SSL={{ 'true' if email.get('use_ssl', False) else 'false' }}
AUTHENTIK_EMAIL__TIMEOUT={{ email.get('timeout', 10) }}
AUTHENTIK_EMAIL__FROM={{ email.get('from', 'authentik@' ~ p.get('domain', 'id.wikioasis.org')) }}
{%- endif %}
{%- if bootstrap_password or bootstrap_token %}

# First boot only. authentik reads these while it creates the default akadmin
# account and ignores them on every start afterwards, so leaving them set is
# harmless but pointless -- clear them from pillar/private once the account
# exists. They are here so the initial-setup flow at /if/flow/initial-setup/ is
# never sitting unclaimed on a public hostname waiting for whoever finds it.
{%- if bootstrap_email %}
AUTHENTIK_BOOTSTRAP_EMAIL={{ bootstrap_email }}
{%- endif %}
{%- if bootstrap_password %}
AUTHENTIK_BOOTSTRAP_PASSWORD={{ bootstrap_password }}
{%- endif %}
{%- if bootstrap_token %}
AUTHENTIK_BOOTSTRAP_TOKEN={{ bootstrap_token }}
{%- endif %}
{%- endif %}
