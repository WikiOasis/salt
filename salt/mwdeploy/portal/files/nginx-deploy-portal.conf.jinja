{%- set p = salt['pillar.get']('mwdeploy_portal', {}) %}
{%- set path = p.get('path', '/srv/deploy-portal') %}
{%- set domain = p.get('domain', 'console.wikioasis.org') %}
{%- set reverb = p.get('reverb', {}) %}
{%- set reverb_port = reverb.get('server_port', 8080) %}
# salt managed, do not modify manually
server {
    listen 80;
    listen [::]:80;
    server_name {{ domain }};

    root {{ path }}/public;
    index index.php;

    client_max_body_size 4m;   # patch uploads are capped at 2 MB by the app

    # TLS terminates at the edge (HAProxy / upstream proxy), so trust its
    # forwarded headers rather than what the client claimed — otherwise
    # Laravel generates http:// URLs and the browser blocks them as mixed
    # content.
    set_real_ip_from 10.0.0.0/8;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    access_log /var/log/nginx/deploy-portal.access.log;
    error_log  /var/log/nginx/deploy-portal.error.log;

    # Reverb — the browser's websocket (laravel-echo connects to /app/{key}).
    location /app {
        proxy_pass http://127.0.0.1:{{ reverb_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host       $host;
        proxy_set_header X-Real-IP  $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

        # A deployment can sit idle for minutes between steps; the default 60s
        # read timeout would drop the socket mid-deploy and the dashboard
        # would silently degrade to polling.
        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;
        proxy_buffering off;
    }

    # Reverb — the server-side HTTP API. Only reachable from loopback in the
    # recommended config (the app dials REVERB_INTERNAL_HOST directly), but
    # proxied here too so a fallback to the public host also works.
    location /apps {
        proxy_pass http://127.0.0.1:{{ reverb_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        allow 127.0.0.1;
        deny all;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    location ~ \.php$ {
        fastcgi_pass unix:/run/php/php{{ p.get('php_version', '8.4') }}-fpm-deploy-portal.sock;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT   $realpath_root;
        # TLS terminates at the edge, so this vhost only ever speaks plain
        # HTTP — tell PHP the original request was HTTPS or Laravel sees an
        # insecure request and emits http:// URLs for assets (vite(), CSS/JS).
        fastcgi_param HTTPS on;
        fastcgi_hide_header X-Powered-By;
        fastcgi_read_timeout 120s;
    }

    # Nothing outside public/ is web-reachable, but be explicit: .env sits one
    # directory up and a misconfiguration exposing it would leak the DB
    # password and APP_KEY.
    location ~ /\.(?!well-known).* { deny all; }
}
