{%- set p = salt['pillar.get']('mwdeploy_portal', {}) %}
{%- set php_version = p.get('php_version', '8.4') %}
; salt managed, do not modify manually
; Its own pool so a slow page here cannot starve the wikis' php-fpm pool.
[deploy-portal]
user = www-data
group = www-data
listen = /run/php/php{{ php_version }}-fpm-deploy-portal.sock
listen.owner = www-data
listen.group = www-data
pm = dynamic
pm.max_children = 10
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 3
php_admin_value[error_log] = /var/log/php{{ php_version }}-fpm-deploy-portal.log
php_admin_flag[log_errors] = on
php_admin_value[memory_limit] = 256M
php_admin_value[upload_max_filesize] = 4M
php_admin_value[post_max_size] = 8M
