{#- mwdeploy portal .env — managed by Salt, do not edit manually.
   Secrets come from pillar/private (gitignored); everything else from
   pillar/mwdeploy_portal and the shared pillar/mediawiki fleet values. #}
{%- set p = salt['pillar.get']('mwdeploy_portal', {}) %}
{%- set mw = salt['pillar.get']('mediawiki', {}) %}
{%- set db = p.get('db', {}) %}
{%- set reverb = p.get('reverb', {}) %}
{%- set rollout = p.get('rollout', {}) %}
{%- set decisions = p.get('decisions', {}) %}
{%- set domain = p.get('domain', 'console.wikioasis.org') %}

APP_NAME="WikiOasis Deploy Portal"
APP_ENV=production
APP_KEY={{ salt['pillar.get']('mwdeploy_portal:app_key', '') }}
APP_DEBUG=false
APP_URL=https://{{ domain }}

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE={{ db.get('name', 'mwdeploy') }}
DB_USERNAME={{ db.get('user', 'mwdeploy') }}
DB_PASSWORD={{ salt['pillar.get']('mwdeploy_portal:db_password', '') }}

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="deploy@wikioasis.org"
MAIL_FROM_NAME="${APP_NAME}"

# Shared secrets between the app, Reverb and the browser — key is public
# (ends up in the JS bundle), secret is app<->Reverb only.
REVERB_APP_ID={{ reverb.get('app_id', 'mwdeploy') }}
REVERB_APP_KEY={{ salt['pillar.get']('mwdeploy_portal:reverb_app_key', '') }}
REVERB_APP_SECRET={{ salt['pillar.get']('mwdeploy_portal:reverb_app_secret', '') }}

# Where the Reverb process listens — loopback only, nginx proxies to it.
REVERB_SERVER_HOST={{ reverb.get('server_host', '127.0.0.1') }}
REVERB_SERVER_PORT={{ reverb.get('server_port', 8080) }}

# The public URL the browser opens a websocket to (edge-terminated).
REVERB_HOST={{ reverb.get('public_host', domain) }}
REVERB_PORT={{ reverb.get('public_port', 443) }}
REVERB_SCHEME={{ reverb.get('public_scheme', 'https') }}

# Where *this app* reaches Reverb server-side. Keep on loopback — dialling out
# through the edge proxy to reach a service on this host's own loopback is a
# pointless round trip that breaks if the edge can't route back to itself.
REVERB_INTERNAL_HOST=127.0.0.1
REVERB_INTERNAL_PORT={{ reverb.get('server_port', 8080) }}
REVERB_INTERNAL_SCHEME=http

# Compiled into the JS bundle at `npm run build` time — a change here needs a
# rebuild (see mwdeploy-portal-assets in portal/init.sls), not just config:clear.
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

###############################################################################
# Deploy portal — Salt transport
# The portal runs on the Salt master and never speaks SSH; every fleet
# operation is `salt '<minion>' cmd.run_all '<mwdeploy-shim ...>'`.
###############################################################################

MWDEPLOY_SALT_BINARY=/usr/bin/salt
MWDEPLOY_SALT_MODULE=cmd.run_all
MWDEPLOY_SALT_TIMEOUT=300
MWDEPLOY_PROCESS_SLACK=60

MWDEPLOY_SHIM_BINARY=/usr/local/bin/mwdeploy-shim

MWDEPLOY_STAGING_PATH={{ mw.get('staging_path', '/srv/mediawiki-staging') }}
MWDEPLOY_PROD_PATH={{ mw.get('prod_path', '/srv/mediawiki') }}
MWDEPLOY_PATCH_PATH={{ mw.get('prod_path', '/srv/mediawiki') }}/scripts/extensions/patches

# Minion id of the staging host — must match `salt-key -L` exactly.
MWDEPLOY_STAGING_TARGET={{ p.get('staging_target', 'staging') }}

MWDEPLOY_DEFAULT_PARALLEL={{ rollout.get('default_parallel', 1) }}
MWDEPLOY_MAX_PARALLEL={{ rollout.get('max_parallel', 8) }}
MWDEPLOY_HAPROXY_BACKEND={{ mw.get('haproxy_backend', 'mediawiki') }}
MWDEPLOY_CANARY_VHOST={{ mw.get('canary_vhost', 'test.wikioasis.org') }}
MWDEPLOY_CANARY_RETRIES={{ rollout.get('canary_retries', 3) }}
MWDEPLOY_L10N_WIKI={{ rollout.get('l10n_wiki', 'testwiki') }}

MWDEPLOY_DECISION_POLL=2
MWDEPLOY_DECISION_TIMEOUT={{ decisions.get('timeout', 900) }}
MWDEPLOY_DECISION_TIMEOUT_DEFAULT={{ decisions.get('timeout_default', 'abort_and_rollback') }}

# salt-master and staging-tree host differ, so branch/commit discovery must
# ask the staging minion rather than shelling out locally.
MWDEPLOY_GIT_DRIVER={{ p.get('git_driver', 'salt') }}
MWDEPLOY_GIT_COMMIT_LIMIT=30
MWDEPLOY_GIT_BINARY=/usr/bin/git
MWDEPLOY_GIT_TIMEOUT=60

# NOTE: MWDEPLOY_RSYNC_SOURCE is exported in mwdeploy.staging's rsyncd module.
MWDEPLOY_RSYNC_SOURCE={{ p.get('rsync_source', 'rsync://staging.wikioasis.org/mediawiki/') }}

# NOTE: patch uploads land in the default local `storage/app/patches` disk on
# THIS host, which is not the staging host — MWDEPLOY_PATCH_STORAGE is left at
# its Laravel default here deliberately. Flagged in SALT-INTEGRATION.md section
# 6: this needs an NFS mount or a sync state before patches are usable, and
# that decision needs a human (see OPEN-QUESTIONS.md).
