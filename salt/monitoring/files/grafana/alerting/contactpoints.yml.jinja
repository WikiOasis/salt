{%- set n = salt['pillar.get']('notifications', {}) %}
apiVersion: 1

contactPoints:
  - orgId: 1
    name: wikioasis-chat
    receivers:
{%- if n.get('slack_webhook_url') %}
      - uid: wikioasis-chat-slack-v2
        type: webhook
        disableResolveMessage: false
        settings:
          url: {{ n.slack_webhook_url | tojson }}
          httpMethod: POST
          payload:
            template: {% raw %}'{{ template "wikioasis.slack.payload" . }}'{% endraw %}
{%- endif %}
{%- if n.get('discord_webhook_url') %}
{%- set discord_url = n.discord_webhook_url ~ ('&' if '?' in n.discord_webhook_url else '?') ~ 'with_components=true' %}
      - uid: wikioasis-chat-discord-v2
        type: webhook
        disableResolveMessage: false
        settings:
          url: {{ discord_url | tojson }}
          httpMethod: POST
          payload:
            template: {% raw %}'{{ template "wikioasis.discord.payload" . }}'{% endraw %}
{%- endif %}
{%- if n.get('incidentio_grafana_url') %}
  - orgId: 1
    name: incidentio
    receivers:
      - uid: incidentio-webhook
        type: webhook
        disableResolveMessage: false
        settings:
          url: {{ n.incidentio_grafana_url | tojson }}
          httpMethod: POST
          authorization_scheme: Bearer
          authorization_credentials: {{ n.get('incidentio_grafana_token', '') | tojson }}
{%- endif %}

deleteContactPoints:
  - orgId: 1
    uid: wikioasis-chat-slack
  - orgId: 1
    uid: wikioasis-chat-discord
