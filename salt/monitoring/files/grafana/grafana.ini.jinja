# Managed by Salt — do not edit manually.
[server]
http_port = 3000
domain = grafana.wikioasis.org
root_url = https://grafana.wikioasis.org
serve_from_sub_path = false

[database]
type = sqlite3
path = grafana.db

[security]
admin_user = {{ admin_user }}
admin_password = {{ admin_pass }}

[users]
allow_sign_up = false

[auth.anonymous]
enabled = false

[auth.generic_oauth]
scopes = openid profile email

[log]
mode = console file
level = info
filters = oauth.generic_oauth:debug

[log.file]
log_rotate = true
max_lines = 1000000
max_size_shift = 28
daily_rotate = true
max_days = 7

[feature_toggles]
grafanaAdvisor = true
splashScreen = true
queryEditorNext = true