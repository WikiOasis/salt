# Managed by Salt — do not edit manually.
global:
  scrape_interval:     30s
  evaluation_interval: 30s

scrape_configs:
  - job_name: 'node'
    file_sd_configs:
      - files: ['/etc/prometheus/file_sd/node.json']
        refresh_interval: 5m

  - job_name: 'mysqld'
    file_sd_configs:
      - files: ['/etc/prometheus/file_sd/mysqld.json']
        refresh_interval: 5m

  - job_name: 'haproxy'
    file_sd_configs:
      - files: ['/etc/prometheus/file_sd/haproxy.json']
        refresh_interval: 5m

  - job_name: 'redis'
    file_sd_configs:
      - files: ['/etc/prometheus/file_sd/redis.json']
        refresh_interval: 5m

  - job_name: 'statsd'
    file_sd_configs:
      - files: ['/etc/prometheus/file_sd/statsd.json']
        refresh_interval: 5m

  - job_name: 'phpfpm'
    file_sd_configs:
      - files: ['/etc/prometheus/file_sd/phpfpm.json']
        refresh_interval: 5m

  - job_name: 'phpopcache'
    file_sd_configs:
      - files: ['/etc/prometheus/file_sd/phpopcache.json']
        refresh_interval: 5m

  - job_name: 'opensearch'
    file_sd_configs:
      - files: ['/etc/prometheus/file_sd/opensearch.json']
        refresh_interval: 5m

  - job_name: 'cloudflare'
    file_sd_configs:
      - files: ['/etc/prometheus/file_sd/cloudflare.json']
        refresh_interval: 5m

  # authentik publishes its metrics port on the vrack address; targets come from
  # monitoring/files/prometheus/file_sd/authentik.json.jinja. Only the server
  # container's port is published, so this is the server's view: the Rust
  # router's own request histogram plus everything the embedded Python exposes
  # (flows, policies, django-prometheus, and the DB-derived worker/task gauges).
  # The worker container has a metrics listener of its own on the same port but
  # it is not published, so the per-actor dramatiq counters are not collected.
  - job_name: 'authentik'
    file_sd_configs:
      - files: ['/etc/prometheus/file_sd/authentik.json']
        refresh_interval: 5m
