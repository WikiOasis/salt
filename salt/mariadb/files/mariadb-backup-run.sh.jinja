#!/bin/bash
# Streams full or incremental mariabackup directly to OVHcloud Object Storage (S3).
#
# Layout in the bucket (one self-contained "set" per weekly full so a set can be
# restored to any point on its own — base + the incrementals that chain off it):
#   s3://$BUCKET/$PREFIX/$HOST/sets/<SET_ID>/base.xbstream.zst
#   s3://$BUCKET/$PREFIX/$HOST/sets/<SET_ID>/incremental/<DATE>.xbstream.zst
#   s3://$BUCKET/$PREFIX/$HOST/sets/latest    (text object naming the newest SET_ID)
# SET_ID is the timestamp of the full that opened the set (YYYYMMDD-HHMMSS).
#
# Each backup is ONE object: the xbstream is uploaded as a single multipart
# stream instead of being unpacked into thousands of small files at the far end.
# Sets are write-once, so they are PUT straight into the Infrequent Access
# storage class ($S3_STORAGE_CLASS) — no day spent paying Standard rates first.
# Note IA charges a per-GiB RETRIEVAL fee, so a restore is not free; that is the
# trade for the much cheaper at-rest price on data we hope never to read.
# Restore unpacks on the way out:
#   aws s3 cp s3://.../base.xbstream.zst - | zstd -dc | mbstream -x -C /restore/base
#   aws s3 cp s3://.../incremental/<DATE>.xbstream.zst - | zstd -dc | mbstream -x -C /restore/inc1
#   mariabackup --prepare --apply-log-only --target-dir=/restore/base
#   mariabackup --prepare --apply-log-only --target-dir=/restore/base --incremental-dir=/restore/inc1
# (drop the `zstd -dc |` stage if mariadb:backup:compress is false)
#
# NOTHING here deletes old backups. Retention is the bucket lifecycle policy
# (see mariadb-backup-lifecycle.json.jinja), which expires objects once they are
# past the IA minimum storage duration. IA carries a 30-day minimum billing
# period per object, so deleting sets from the script — as the old retain_sets
# pruning did — would just buy early-deletion charges.
#
# No backup data is written to local disk — only small state files are kept:
#   /var/backups/mariadb/xtrabackup_checkpoints  (LSN for next incremental)
#   /var/backups/mariadb/current_set             (SET_ID incrementals chain into)
#   /var/backups/mariadb/last_full_backup        (epoch of last full)
#   /var/backups/mariadb/last_backup             (epoch of last backup of any kind)
# Usage: mariadb-backup-run.sh [full|incremental]
{%- set backup = salt['pillar.get']('mariadb:backup', {}) %}
{%- set discord = salt['pillar.get']('notifications:discord_webhook_url', '') %}
{%- set slack = salt['pillar.get']('notifications:slack_webhook_url', '') %}
{%- set compress = backup.get('compress', true) %}
{%- set schedule = backup.get('schedule', {}) %}
{%- set sentry = backup.get('sentry', {}) %}
{%- set sentry_full = sentry.get('full', {}) %}
{%- set sentry_incremental = sentry.get('incremental', {}) %}
set -euo pipefail
ulimit -n 524288
MODE="${1:-incremental}"
STATE_DIR=/var/backups/mariadb

# Serialize backups. A busy DB's incremental can run for the better part of an
# hour; without a lock a manual rerun or an overrun into the next scheduled run
# would start a second mariabackup against the same state files and corrupt the
# LSN tracking. Non-blocking: if one is already running we just skip this run.
LOCK_FILE=/run/mariadb-backup.lock
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Another backup is already running; skipping"
    exit 0
fi
CHECKPOINTS="$STATE_DIR/xtrabackup_checkpoints"
CURRENT_SET_FILE="$STATE_DIR/current_set"
LAST_FULL="$STATE_DIR/last_full_backup"
LAST_BACKUP="$STATE_DIR/last_backup"
MYSQL_USER="{{ backup.get('user', 'mariadb_backup') }}"
MYSQL_PASS="{{ backup.get('password', '') }}"
HOST=$(hostname -s)
START=$(date +%s)

# S3_BUCKET / S3_PREFIX / S3_ENDPOINT / S3_REGION plus the AWS_* locations.
set -a
. /etc/mariadb-backup/s3.env
set +a

BASE_PREFIX="${S3_PREFIX:+${S3_PREFIX}/}$HOST"
SETS_PREFIX="$BASE_PREFIX/sets"

DISCORD_WEBHOOK_URL="{{ discord }}"
SLACK_WEBHOOK_URL="{{ slack }}"

aws_s3() { aws --endpoint-url "$S3_ENDPOINT" --region "$S3_REGION" "$@"; }

# Sentry Crons check-in for this run. One monitor per cron job (full vs
# incremental) so a missed/failed weekly full and a missed/failed daily
# incremental page as distinct monitors. The DSN is the normal per-project SDK
# DSN (https://<public_key>@<ingest-host>/<project_id>); parsed here rather
# than asking for the ingest host/project id/key as three separate pillar
# values. Empty DSN disables check-ins entirely — nothing below fires.
SENTRY_DSN="{{ sentry.get('dsn', '') }}"
case "$MODE" in
    full)
        SENTRY_MONITOR_SLUG="{{ sentry_full.get('monitor_slug', 'mariadb-backup-full') }}"
        SENTRY_CHECKIN_MARGIN="{{ sentry_full.get('checkin_margin', 30) }}"
        SENTRY_MAX_RUNTIME="{{ sentry_full.get('max_runtime', 360) }}"
        SENTRY_CRON_SCHEDULE="{{ schedule.get('full_minute', '0') }} {{ schedule.get('full_hour', '1') }} * * 0"
        ;;
    incremental)
        SENTRY_MONITOR_SLUG="{{ sentry_incremental.get('monitor_slug', 'mariadb-backup-incremental') }}"
        SENTRY_CHECKIN_MARGIN="{{ sentry_incremental.get('checkin_margin', 15) }}"
        SENTRY_MAX_RUNTIME="{{ sentry_incremental.get('max_runtime', 120) }}"
        SENTRY_CRON_SCHEDULE="{{ schedule.get('incremental_minute', '0') }} {{ schedule.get('incremental_hour', '2') }} * * 1-6"
        ;;
esac

SENTRY_CRONS_URL=""
if [ -n "$SENTRY_DSN" ] \
    && [[ "$SENTRY_DSN" =~ ^https?://([^:@/]+)@([^/]+)/([0-9]+)/?$ ]]; then
    SENTRY_CRONS_URL="https://${BASH_REMATCH[2]}/api/${BASH_REMATCH[3]}/cron/${SENTRY_MONITOR_SLUG}/${BASH_REMATCH[1]}/"
elif [ -n "$SENTRY_DSN" ]; then
    log "WARNING: mariadb:backup:sentry:dsn is set but not a valid DSN (expected https://<key>@<host>/<project_id>); skipping check-ins"
fi

# Best-effort: a Sentry outage or a bad DSN must never take a backup down with it.
sentry_checkin() {
    local status="$1"
    [ -z "$SENTRY_CRONS_URL" ] && return 0
    if [ "$status" = "in_progress" ]; then
        jq -n --arg schedule "$SENTRY_CRON_SCHEDULE" \
            --argjson margin "$SENTRY_CHECKIN_MARGIN" --argjson runtime "$SENTRY_MAX_RUNTIME" \
            '{monitor_config:{schedule:{type:"crontab",value:$schedule},checkin_margin:$margin,max_runtime:$runtime,timezone:"UTC"},status:"in_progress"}' \
        | curl -sSL --max-time 10 -X POST -H "Content-Type: application/json" -d @- \
            "$SENTRY_CRONS_URL" >/dev/null 2>&1 || true
    else
        curl -sSL --max-time 10 "${SENTRY_CRONS_URL}?status=${status}" >/dev/null 2>&1 || true
    fi
}

# Compress the stream before it leaves the host so the upload moves far fewer
# bytes, which shortens the backup window (the real fix for redo-log wrap on
# large/busy DBs). Unlike the old SSH destination there is nothing on the far
# end to decompress, so backups are also STORED compressed — that is the point,
# it is what the Infrequent Access tier is billed on. Set mariadb:backup:compress
# to false to store raw xbstream instead. zstd -T0 uses all cores; level 3 is a
# fast, high-ratio default.
{%- if compress %}
COMPRESS="zstd -T0 -3"
STREAM_EXT=".xbstream.zst"
{%- else %}
COMPRESS="cat"
STREAM_EXT=".xbstream"
{%- endif %}

# pv only exists to feed the progress heartbeat a byte count; a missing pv must
# not take the backup down with it.
if command -v pv >/dev/null 2>&1; then
    METER="pv -f -b -i 60"
else
    METER="cat"
fi

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; }

notify() {
    local emoji="$1" text="$2"
    local msg="${emoji} [${HOST}] ${text}"
    if [ -n "$DISCORD_WEBHOOK_URL" ]; then
        jq -n --arg m "$msg" '{username:"Backup",content:$m}' \
        | curl -sSL --max-time 30 -X POST -H "Content-Type: application/json" -d @- \
            "$DISCORD_WEBHOOK_URL" || true
    fi
    if [ -n "$SLACK_WEBHOOK_URL" ]; then
        jq -n --arg m "$msg" '{text:$m}' \
        | curl -sSL --max-time 30 -X POST -H "Content-Type: application/json" -d @- \
            "$SLACK_WEBHOOK_URL" || true
    fi
}

on_exit() {
    local code=$?
    # Clean up any per-run --extra-lsndir temp dirs and meter files a failed
    # backup left behind.
    rm -rf "$STATE_DIR"/lsn.* 2>/dev/null || true
    rm -f "$STATE_DIR"/meter.* 2>/dev/null || true
    if [ $code -ne 0 ]; then
        local elapsed=$(( $(date +%s) - START ))
        notify ":x:" "${MODE} backup FAILED after ${elapsed}s (exit ${code})"
        sentry_checkin "error"
    fi
}
trap on_exit EXIT

object_size() {
    # Best-effort; never let a transient head-object hiccup fail an otherwise-good
    # backup (the data is already safely in the bucket by the time this runs).
    local bytes
    bytes=$(aws_s3 s3api head-object --bucket "$S3_BUCKET" --key "$1" \
        --query ContentLength --output text 2>/dev/null) || true
    if [[ "$bytes" =~ ^[0-9]+$ ]]; then
        numfmt --to=iec --suffix=B "$bytes" 2>/dev/null || echo "${bytes} bytes"
    else
        echo "unknown"
    fi
}

# While the backup pipeline (PID $1) is still running, periodically log elapsed
# time and how much has been pushed so far, read from pv's byte counter ($2).
# The upload is a single in-flight multipart object, so its parts are not
# listable until it completes — the local meter is the only progress signal.
# Only fires for backups that run longer than $interval, so quiet incrementals
# stay silent.
progress_heartbeat() {
    local pid="$1" meter="$2"
    local interval=300 poll=5 waited=0
    # Poll far more often than we log: this function is what the main script
    # blocks on, so a bare `sleep $interval` would pad every single backup with
    # up to $interval of doing nothing after the stream had already finished.
    while kill -0 "$pid" 2>/dev/null; do
        sleep "$poll"
        waited=$(( waited + poll ))
        [ "$waited" -lt "$interval" ] && continue
        waited=0
        local elapsed=$(( $(date +%s) - START ))
        local sent
        sent=$(tr '\r' '\n' < "$meter" 2>/dev/null | tail -1 | tr -d ' ')
        log "  ... still running (${elapsed}s elapsed, ${sent:-unknown} streamed to S3 so far)"
    done
}

# Fail before mariabackup burns an hour on a stream with nowhere to land.
preflight() {
    if [ -z "${S3_BUCKET:-}" ]; then
        log "ERROR: S3_BUCKET is empty in /etc/mariadb-backup/s3.env"
        exit 1
    fi
    local err
    # Keep the CLI's own message: an unresolvable endpoint, a 403 and a 404 all
    # arrive here and each needs a different fix. Note OVHcloud US regions (us-*)
    # live on .io.cloud.ovh.us, EU/CA/APAC on .io.cloud.ovh.net — the wrong one
    # is an NXDOMAIN that otherwise reads as "the bucket is missing".
    if ! err=$(aws_s3 s3api head-bucket --bucket "$S3_BUCKET" 2>&1); then
        log "ERROR: cannot reach bucket ${S3_BUCKET} at ${S3_ENDPOINT} — aborting before starting mariabackup"
        log "ERROR:   aws said: ${err}"
        exit 1
    fi
    # head-bucket only proves the bucket exists and is readable. A credential
    # without PutObject, a rotated secret or a tightened bucket policy all pass
    # it and then fail at the END of a multi-hour full. Prove we can write.
    # Standard class and deleted immediately, so it has no minimum to charge.
    local probe="$BASE_PREFIX/.preflight.$$"
    if ! err=$(printf 'ok\n' | aws_s3 s3 cp - "s3://$S3_BUCKET/$probe" --only-show-errors 2>&1); then
        log "ERROR: cannot write to s3://${S3_BUCKET}/${probe} — check the S3 user's permissions"
        log "ERROR:   aws said: ${err}"
        exit 1
    fi
    aws_s3 s3 rm "s3://$S3_BUCKET/$probe" --only-show-errors >/dev/null 2>&1 \
        || log "WARNING: could not remove preflight probe object ${probe}"
}

# Record the checkpoint LSN from the backup that just ran, read from a fresh
# per-run --extra-lsndir (passed in as $1). We deliberately do NOT read a streamed
# xtrabackup_checkpoints back out of the bucket: mariabackup does not emit that
# file into the --stream=xbstream output here (confirmed — it never lands at the
# destination), so every run silently fell back to a full. --extra-lsndir writes
# the checkpoints locally by the local mariabackup process regardless of where
# the stream goes.
#
# The earlier "extra-lsndir is stale" problem came from reusing a *persistent*
# lsndir: a backup that died before writing checkpoints left an old to_lsn behind,
# so the next incremental chained from an ever-older LSN until it ballooned. A fresh
# mktemp dir per run already prevents that, so the only thing we reject here is a
# to_lsn that goes *backwards* past where this backup started ($2, default 0) —
# a genuine anomaly. Note an idle DB legitimately reports an UNCHANGED checkpoint
# to_lsn (InnoDB only advances it on write activity), so equal is fine and must be
# accepted, else every backup on a quiet DB would fall back to a needless full.
save_checkpoints() {
    local lsndir="$1" min_lsn="${2:-0}"
    # MariaDB 11.x mariabackup writes mariadb_backup_checkpoints; older builds
    # (and Percona xtrabackup) used xtrabackup_checkpoints. Accept whichever exists.
    local cpfile=""
    local name
    for name in mariadb_backup_checkpoints xtrabackup_checkpoints; do
        if [ -f "$lsndir/$name" ]; then cpfile="$lsndir/$name"; break; fi
    done
    if [ -z "$cpfile" ]; then
        log "WARNING: mariabackup wrote no checkpoints to ${lsndir} — NEXT RUN WILL DO A FULL"
        log "WARNING:   dir contents: $(ls -a "$lsndir" 2>/dev/null | tr '\n' ' ')"
        rm -f "$CHECKPOINTS"
        return 0
    fi
    local new_lsn; new_lsn=$(awk '/^to_lsn/{print $3}' "$cpfile")
    if ! [[ "$new_lsn" =~ ^[0-9]+$ ]]; then
        log "WARNING: checkpoints ${cpfile} has no valid to_lsn ('${new_lsn}') — NEXT RUN WILL DO A FULL"
        log "WARNING:   file contents: $(tr '\n' ' ' < "$cpfile")"
        rm -f "$CHECKPOINTS"
        return 0
    fi
    if [ "$new_lsn" -lt "$min_lsn" ]; then
        log "WARNING: checkpoint to_lsn (${new_lsn}) went BACKWARDS past ${min_lsn} — anomalous; NEXT RUN WILL DO A FULL"
        rm -f "$CHECKPOINTS"
        return 0
    fi
    cp "$cpfile" "$CHECKPOINTS"
    log "Saved checkpoints (to_lsn=${new_lsn}); next incremental will chain from here"
}

run_full() {
    local set_id; set_id=$(date +%Y%m%d-%H%M%S)
    local key="$SETS_PREFIX/$set_id/base$STREAM_EXT"
    local uri="s3://$S3_BUCKET/$key"
    local lsndir; lsndir=$(mktemp -d "$STATE_DIR/lsn.XXXXXX")
    local meter; meter=$(mktemp "$STATE_DIR/meter.XXXXXX")
    log "=== Starting FULL backup: opening new set ${set_id} ==="
    log "  destination: ${uri}"

    (
        mariabackup --backup --stream=xbstream \
            --extra-lsndir="$lsndir" \
            --open-files-limit=524288 \
            --user="$MYSQL_USER" --password="$MYSQL_PASS" \
        | $COMPRESS \
        | $METER 2>"$meter" \
        | aws_s3 s3 cp - "$uri" --storage-class "$S3_STORAGE_CLASS" --only-show-errors
    ) &
    local pid=$!
    progress_heartbeat "$pid" "$meter"
    if ! wait "$pid"; then
        # Same reasoning as the incremental path below, and it matters more here:
        # a truncated base leaves the whole set unrestorable while still looking
        # complete in a listing, and it would sit in IA for the 30-day minimum.
        # CURRENT_SET_FILE is deliberately not advanced, so the next incremental
        # still chains onto the previous, intact set.
        log "FULL backup pipeline failed; removing the partial object at ${uri}"
        rm -f "$meter"; rm -rf "$lsndir"
        aws_s3 s3 rm "$uri" --only-show-errors 2>/dev/null || true
        return 1
    fi
    rm -f "$meter"
    log "Backup stream finished; saving checkpoints"

    save_checkpoints "$lsndir"
    rm -rf "$lsndir"

    # Point subsequent incrementals at this set, and update the convenience
    # pointer object (S3 has no symlinks, so `latest` is a file holding the ID).
    # Deliberately left in Standard: it is a handful of bytes that gets
    # overwritten weekly, and IA would bill it at the 128KB minimum object size
    # plus an early-deletion fee on every overwrite.
    echo "$set_id" > "$CURRENT_SET_FILE"
    log "Current backup set is now ${set_id}; incrementals will chain into it"
    printf '%s\n' "$set_id" \
    | aws_s3 s3 cp - "s3://$S3_BUCKET/$SETS_PREFIX/latest" --content-type text/plain --only-show-errors \
        || log "WARNING: could not update '${SETS_PREFIX}/latest' pointer"

    local now; now=$(date +%s)
    echo "$now" > "$LAST_FULL"
    echo "$now" > "$LAST_BACKUP"

    local elapsed=$(( now - START ))
    local size; size=$(object_size "$key")
    log "=== FULL backup finished: set ${set_id}, size: ${size}, duration: ${elapsed}s ==="
    notify ":white_check_mark:" "full backup complete (set ${set_id}) — size: ${size}, duration: ${elapsed}s"
}

run_incremental() {
    log "Evaluating incremental preconditions"

    # An incremental must chain onto an existing set's base. No recorded set means
    # nothing for it to chain onto, so we have to take a full first.
    if [ ! -f "$CURRENT_SET_FILE" ]; then
        log "No current set recorded (${CURRENT_SET_FILE} missing); running FULL backup first"
        run_full
        return
    fi
    local set_id; set_id=$(cat "$CURRENT_SET_FILE")
    log "Current set: ${set_id} (${SETS_PREFIX}/${set_id})"

    if [ ! -f "$CHECKPOINTS" ]; then
        log "No checkpoints file at ${CHECKPOINTS} — no LSN to chain from; running FULL backup first"
        run_full
        return
    fi
    log "Checkpoints file ${CHECKPOINTS} contents:"
    while IFS= read -r line; do log "    ${line}"; done < "$CHECKPOINTS"

    local last_full_epoch; last_full_epoch=$(cat "$LAST_FULL" 2>/dev/null || echo 0)
    local full_age=$(( ($(date +%s) - last_full_epoch) / 86400 ))
    log "Last full backup was ${full_age}d ago (epoch ${last_full_epoch})"
    if [ "$full_age" -ge 7 ]; then
        log "Full backup is ${full_age}d old (>=7d, weekly run missed); running FULL backup first"
        run_full
        return
    fi

    local to_lsn; to_lsn=$(awk '/^to_lsn/{print $3}' "$CHECKPOINTS")
    if ! [[ "$to_lsn" =~ ^[0-9]+$ ]]; then
        log "Checkpoints file has no valid to_lsn ('${to_lsn}'); running FULL backup"
        rm -f "$CHECKPOINTS"
        run_full
        return
    fi
    local DATE; DATE=$(date +%Y%m%d-%H%M%S)
    local key="$SETS_PREFIX/$set_id/incremental/$DATE$STREAM_EXT"
    local uri="s3://$S3_BUCKET/$key"
    local lsndir; lsndir=$(mktemp -d "$STATE_DIR/lsn.XXXXXX")
    local meter; meter=$(mktemp "$STATE_DIR/meter.XXXXXX")

    log "=== Starting INCREMENTAL backup: set ${set_id}, from LSN ${to_lsn} ==="
    log "  destination: ${uri}"

    (
        mariabackup --backup --stream=xbstream \
            --incremental-lsn="$to_lsn" \
            --extra-lsndir="$lsndir" \
            --open-files-limit=524288 \
            --user="$MYSQL_USER" --password="$MYSQL_PASS" \
        | $COMPRESS \
        | $METER 2>"$meter" \
        | aws_s3 s3 cp - "$uri" --storage-class "$S3_STORAGE_CLASS" --only-show-errors
    ) &
    local pid=$!
    progress_heartbeat "$pid" "$meter"
    if ! wait "$pid"; then
        # Any stage of the pipeline can land here — an S3 outage, an expired
        # credential, a full $STATE_DIR, an OOM-killed zstd — so don't name a
        # single cause. The fallback full will usually succeed and hide the real
        # fault, which makes an accurate log line the only trail left.
        log "Incremental backup pipeline failed (chaining from LSN ${to_lsn}); possible causes: an LSN incompatible with the current server state, an S3 upload error, or a local resource limit. Falling back to FULL backup"
        rm -f "$CHECKPOINTS" "$meter"; rm -rf "$lsndir"
        # A truncated object is worse than none: it would look restorable in a
        # listing. Any multipart parts the CLI could not abort are swept up by
        # the lifecycle's AbortIncompleteMultipartUpload rule.
        aws_s3 s3 rm "$uri" --only-show-errors 2>/dev/null || true
        run_full
        return
    fi
    rm -f "$meter"
    log "Backup stream finished; saving checkpoints"

    # Advance the checkpoint so the next incremental chains from this one. Require
    # the new to_lsn to advance past where we started ($to_lsn), else it's stale.
    save_checkpoints "$lsndir" "$to_lsn"
    rm -rf "$lsndir"

    local now; now=$(date +%s)
    echo "$now" > "$LAST_BACKUP"

    local elapsed=$(( now - START ))
    local size; size=$(object_size "$key")
    log "=== INCREMENTAL backup finished: set ${set_id}, object: ${DATE}${STREAM_EXT}, size: ${size}, duration: ${elapsed}s ==="
    notify ":white_check_mark:" "incremental backup complete (set ${set_id}) — size: ${size}, duration: ${elapsed}s"
}

log "mariadb-backup-run starting: mode=${MODE}, host=${HOST}, destination=s3://${S3_BUCKET}/${SETS_PREFIX} via ${S3_ENDPOINT}"

case "$MODE" in
    full|incremental) sentry_checkin "in_progress" ;;
esac

preflight

case "$MODE" in
    full)        run_full ;;
    incremental) run_incremental ;;
    *)           echo "Usage: $0 [full|incremental]" >&2; exit 1 ;;
esac

sentry_checkin "ok"
log "mariadb-backup-run finished: mode=${MODE}"
