{#-
  OVHcloud Object Storage lifecycle policy for the MariaDB backup bucket.
  Applied by mariadb-backup-s3-init.sh via `s3api put-bucket-lifecycle-configuration`.

  Backup sets and rotated binlogs are already PUT directly into the Infrequent
  Access class by the upload scripts, so rule 1's transition is a backstop, not
  the main event: it catches anything that landed in Standard — objects written
  before this policy existed, uploads from other tooling, and the active binlog
  once it stops being overwritten (it is deliberately kept in Standard while it
  is still growing, see mariadb-binlog-sync.sh).

  Rule 1's expiration is the part that matters day to day, and it is the ONLY
  thing that deletes old backups — the scripts never remove remote data. IA is
  billed for a 730h (30 day) MINIMUM per object and deleting sooner still costs
  the remainder, so expire_days is clamped below to at least transition_days + 30
  (>= 30 days from upload either way).

  Rule 2 aborts orphaned multipart uploads. A full backup is a single multi-GB
  streamed multipart upload; if it dies mid-flight the uploaded parts are billed
  but invisible to `s3 ls`, so this rule is what stops them accumulating.

  Objects under 128KB are not transitioned by OVHcloud (they stay in Standard,
  which is cheaper for them anyway); they are still expired by rule 1.
-#}
{%- set backup = salt['pillar.get']('mariadb:backup', {}) %}
{%- set s3 = backup.get('s3', {}) %}
{%- set lc = s3.get('lifecycle', {}) %}
{%- set prefix = s3.get('prefix', '').strip('/') %}
{%- set filter_prefix = (prefix ~ '/') if prefix else '' %}
{#- Same class the uploads use, so the backstop can never disagree with them. #}
{%- set storage_class = s3.get('storage_class', 'STANDARD_IA') %}
{%- set transition_days = lc.get('transition_days', 1)|int %}
{%- set min_storage_days = lc.get('min_storage_days', 30)|int %}
{%- set expire_days = [lc.get('expire_days', 35)|int, transition_days + min_storage_days]|max %}
{%- set abort_days = lc.get('abort_incomplete_multipart_days', 7)|int %}
{
  "Rules": [
    {
      "ID": "mariadb-backups-infrequent-access",
      "Status": "Enabled",
      "Filter": { "Prefix": "{{ filter_prefix }}" },
      "Transitions": [
        { "Days": {{ transition_days }}, "StorageClass": "{{ storage_class }}" }
      ],
      "Expiration": { "Days": {{ expire_days }} },
      "NoncurrentVersionExpiration": { "NoncurrentDays": {{ expire_days }} }
    },
    {
      "ID": "mariadb-backups-abort-incomplete-uploads",
      "Status": "Enabled",
      "Filter": { "Prefix": "{{ filter_prefix }}" },
      "AbortIncompleteMultipartUpload": { "DaysAfterInitiation": {{ abort_days }} }
    }
  ]
}
