# Shared S3 settings for the MariaDB backup scripts. Sourced with `set -a` by
# mariadb-backup-run.sh, mariadb-binlog-sync.sh and mariadb-backup-s3-init.sh,
# so every AWS_* name here also becomes an environment variable for the aws CLI.
{%- set backup = salt['pillar.get']('mariadb:backup', {}) %}
{%- set s3 = backup.get('s3', {}) %}
{%- set region = s3.get('region', 'gra') %}
{#- Lifecycle rules only work on the `.io` endpoint — the legacy `.perf` one
    silently rejects them, so derive `.io` unless explicitly overridden. #}
{%- set endpoint = s3.get('endpoint', 'https://s3.' ~ region ~ '.io.cloud.ovh.net') %}
{%- set prefix = s3.get('prefix', '').strip('/') %}
S3_BUCKET='{{ s3.get('bucket', '') }}'
S3_REGION='{{ region }}'
S3_ENDPOINT='{{ endpoint }}'
S3_PREFIX='{{ prefix }}'
# Storage class for write-once objects, set on the PUT itself so they are billed
# as Infrequent Access from the moment they land rather than spending a day in
# Standard first. Objects that get OVERWRITTEN must not use it — see the 30-day
# minimum note in mariadb-binlog-sync.sh.
S3_STORAGE_CLASS='{{ s3.get('storage_class', 'STANDARD_IA') }}'

AWS_CONFIG_FILE=/etc/mariadb-backup/aws.conf
AWS_SHARED_CREDENTIALS_FILE=/etc/mariadb-backup/credentials
# These are not EC2 instances; without this the CLI stalls probing IMDS
# whenever a credential lookup misses.
AWS_EC2_METADATA_DISABLED=true
